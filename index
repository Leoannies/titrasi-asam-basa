<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lab Maya Titrasi Asam-Basa</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #1a1a2e;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
      color: #fff;
    }

    #app-container {
      width: 100vw;
      height: 56.25vw; /* 16:9 Aspect Ratio */
      max-width: 177.78vh;
      max-height: 100vh;
      position: relative;
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Header Bar */
    header {
      height: 60px;
      padding: 0 20px;
      background: rgba(0, 0, 0, 0.4);
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-title {
      font-size: 1.2rem;
      font-weight: bold;
      color: #00d2ff;
      letter-spacing: 1px;
    }

    .header-controls {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .btn-header {
      background: #3a7bd5;
      color: white;
      border: none;
      padding: 8px 15px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.3s ease;
      font-size: 0.85rem;
    }

    .btn-header:hover {
      background: #3a6073;
      transform: translateY(-2px);
    }

    .logo-kemendikdasmen {
      height: 45px;
      width: auto;
      object-fit: contain;
    }

    /* Screen Management */
    .screen {
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      bottom: 0;
      display: none;
      padding: 20px;
    }

    .screen.active {
      display: flex;
    }

    /* Home Screen */
    #home-screen {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 40px 60px;
      background: radial-gradient(circle at center, rgba(32, 58, 67, 0.8), rgba(15, 32, 39, 0.95));
    }

    .home-left {
      max-width: 50%;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .home-left h1 {
      font-size: 2.5rem;
      color: #00d2ff;
      line-height: 1.2;
      text-shadow: 0 2px 10px rgba(0,210,255,0.3);
    }

    .home-left p {
      font-size: 1rem;
      color: #e0e0e0;
      line-height: 1.5;
    }

    .home-buttons {
      display: flex;
      gap: 15px;
      margin-top: 15px;
    }

    .btn-main {
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: bold;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .btn-primary {
      background: linear-gradient(45deg, #00c6ff, #0072ff);
      color: white;
    }

    .btn-primary:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px rgba(0, 198, 255, 0.4);
    }

    .btn-secondary {
      background: linear-gradient(45deg, #11998e, #38ef7d);
      color: white;
    }

    .btn-secondary:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px rgba(56, 239, 125, 0.4);
    }

    .home-right {
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .anime-character {
      max-height: 90%;
      max-width: 100%;
      object-fit: contain;
      filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5));
    }

    /* Activity Screen */
    #activity-screen {
      flex-direction: row;
      gap: 20px;
    }

    .control-panel {
      width: 320px;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      border-radius: 10px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 15px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow-y: auto;
    }

    .panel-group {
      background: rgba(0, 0, 0, 0.2);
      padding: 12px;
      border-radius: 8px;
      border-left: 4px solid #00d2ff;
    }

    .panel-group h3 {
      font-size: 0.95rem;
      color: #00d2ff;
      margin-bottom: 8px;
    }

    .form-control {
      margin-bottom: 8px;
    }

    .form-control label {
      display: block;
      font-size: 0.8rem;
      margin-bottom: 4px;
      color: #ccc;
    }

    .form-control select, .form-control input {
      width: 100%;
      padding: 6px 10px;
      background: #1a1a2e;
      border: 1px solid #3a7bd5;
      color: white;
      border-radius: 4px;
      font-size: 0.85rem;
    }

    .lab-area {
      flex: 1;
      background: rgba(0, 0, 0, 0.25);
      border-radius: 10px;
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .canvas-container {
      position: relative;
      width: 400px;
      height: 100%;
      display: flex;
      justify-content: center;
    }

    /* SVG Interactive Lab Apparatus */
    svg {
      width: 100%;
      height: 100%;
    }

    /* Warning Overlay */
    .warning-banner {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255, 193, 7, 0.9);
      color: #000;
      padding: 8px 20px;
      border-radius: 20px;
      font-weight: bold;
      font-size: 0.9rem;
      display: none;
      animation: pulse 1s infinite alternate;
      box-shadow: 0 0 15px rgba(255, 193, 7, 0.6);
      z-index: 5;
    }

    @keyframes pulse {
      from { opacity: 0.8; transform: translateX(-50%) scale(0.98); }
      to { opacity: 1; transform: translateX(-50%) scale(1.02); }
    }

    /* Calculation Toggle Box */
    .calc-box {
      background: rgba(0, 0, 0, 0.3);
      padding: 10px;
      border-radius: 6px;
      margin-top: 5px;
    }

    .calc-content {
      display: none;
      margin-top: 8px;
      font-size: 0.85rem;
      color: #2ecc71;
    }

    /* Modal Documentation */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.8);
      z-index: 100;
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background: #1a1a2e;
      width: 70%;
      max-height: 80%;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid #00d2ff;
      overflow-y: auto;
      color: #e0e0e0;
    }

    .modal-content h2 {
      color: #00d2ff;
      margin-bottom: 15px;
    }

    .modal-content p, .modal-content ul {
      margin-bottom: 12px;
      line-height: 1.5;
      font-size: 0.9rem;
    }

    .close-modal {
      float: right;
      cursor: pointer;
      font-size: 1.5rem;
      color: #ff5252;
    }
  </style>
</head>
<body>

<div id="app-container">
  <!-- Header -->
  <header>
    <div class="header-title">LAB MAYA TITRASI ASAM-BASA</div>
    <div class="header-controls">
      <button class="btn-header" onclick="showPromptAuthor()">Penulis Prompt</button>
      <button class="btn-header" onclick="toggleFullscreen()">Fullscreen</button>
      <img src="gambar/logo_kemendikdasmen.svg" alt="Logo Kemendikdasmen" class="logo-kemendikdasmen">
    </div>
  </header>

  <!-- Halaman Muka (Home Screen) -->
  <div id="home-screen" class="screen active">
    <div class="home-left">
      <h1>Simulasi Virtual Titrasi Asam-Basa</h1>
      <p>Selamat datang di Laboratorium Maya Titrasi. Pelajari proses penentuan konsentrasi larutan asam melalui metode titrasi secara interaktif dan mandiri.</p>
      <div class="home-buttons">
        <button class="btn-main btn-primary" onclick="startPracticum()">Mulai Praktikum</button>
        <button class="btn-main btn-secondary" onclick="openDocs()">Panduan Penggunaan</button>
      </div>
    </div>
    <div class="home-right">
      <img src="gambar/anime_character.svg" alt="Karakter Anime Edukasi" class="anime-character">
    </div>
  </div>

  <!-- Halaman Aktivitas (Activity Screen) -->
  <div id="activity-screen" class="screen">
    <!-- Panel Kontrol & Variabel -->
    <div class="control-panel">
      <div class="panel-group">
        <h3>Pengaturan Basa (Titran - NaOH)</h3>
        <div class="form-control">
          <label for="molarity-base">Molaritas Basa (Mb):</label>
          <select id="molarity-base" onchange="resetExperiment()">
            <option value="0.1">0.1 M</option>
            <option value="0.2">0.2 M</option>
            <option value="0.5">0.5 M</option>
          </select>
        </div>
      </div>

      <div class="panel-group">
        <h3>Sampel Asam (Titrat - HCl)</h3>
        <div class="form-control">
          <label for="volume-acid">Volume Asam (Va):</label>
          <select id="volume-acid" onchange="resetExperiment()">
            <option value="10">10 mL</option>
            <option value="20">20 mL</option>
            <option value="25">25 mL</option>
          </select>
        </div>
        <div class="form-control">
          <label>Indikator:</label>
          <input type="text" value="Fenolftalein (PP)" disabled>
        </div>
      </div>

      <div class="panel-group">
        <h3>Aksi Titrasi</h3>
        <button class="btn-header" style="width: 100%; margin-bottom: 8px; background: #27ae60;" onclick="drip()">Teteskan Basa (+0.5 mL)</button>
        <button class="btn-header" style="width: 100%; background: #e74c3c;" onclick="resetExperiment()">Ulangi Percobaan</button>
      </div>

      <div class="panel-group">
        <h3>Hasil Data Titrasi</h3>
        <p style="font-size:0.85rem;">Volume Titran Tertes: <span id="volume-added" style="color:#00d2ff; font-weight:bold;">0.0</span> mL</p>
        <p style="font-size:0.85rem; margin-top:4px;">Status Warna: <span id="color-status" style="font-weight:bold; color:#fff;">Bening</span></p>
      </div>

      <!-- Fitur Penutup Perhitungan (Bisa Ditutup/Dibuka) -->
      <div class="calc-box">
        <button class="btn-header" style="width: 100%; background: #8e44ad;" onclick="toggleCalc()">Tampilkan / Sembunyikan Perhitungan</button>
        <div id="calc-content" class="calc-content">
          <p><strong>Rumus:</strong> Va × Ma = Vb × Mb</p>
          <p>Ma = (Vb × Mb) / Va</p>
          <p style="margin-top: 5px;"><strong>Hasil Molaritas Asam:</strong></p>
          <p id="calc-result" style="font-size: 1.1rem; font-weight: bold; color: #f1c40f;">? M</p>
        </div>
      </div>
    </div>

    <!-- Area Laboratorium Visual -->
    <div class="lab-area">
      <div id="warning-banner" class="warning-banner">⚠️ Mendekati Titik Akhir Titrasi! Hati-hati meneteskan.</div>
      
      <div class="canvas-container">
        <!-- SVG Interactive Lab Apparatus -->
        <svg viewBox="0 0 300 500">
          <!-- Stand & Clamp -->
          <rect x="145" y="400" width="100" height="15" fill="#555"/>
          <rect x="190" y="50" width="10" height="350" fill="#777"/>
          <rect x="140" y="120" width="50" height="8" fill="#444"/>

          <!-- Buret -->
          <rect x="135" y="40" width="10" height="240" fill="none" stroke="#fff" stroke-width="2"/>
          <!-- Fluid in Buret -->
          <rect id="buret-fluid" x="136" y="50" width="8" height="225" fill="#a8c0ff" opacity="0.7"/>
          <!-- Buret Valve -->
          <circle cx="140" cy="285" r="5" fill="#e74c3c"/>

          <!-- Falling Drip Drop -->
          <circle id="drip-drop" cx="140" cy="295" r="3" fill="#3498db" opacity="0"/>

          <!-- Erlenmeyer Flask -->
          <path d="M 125 320 L 155 320 L 180 400 L 100 400 Z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
          <rect x="133" y="305" width="14" height="16" fill="none" stroke="#fff" stroke-width="2"/>
          
          <!-- Fluid in Erlenmeyer -->
          <path id="flask-fluid" d="M 112 380 L 168 380 L 178 398 L 102 398 Z" fill="rgba(255, 255, 255, 0.2)" transition="fill 0.5s"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- Modal Panduan Docs -->
<div id="docs-modal" class="modal">
  <div class="modal-content">
    <span class="close-modal" onclick="closeDocs()">&times;</span>
    <h2>Panduan Penggunaan Lab Maya Titrasi</h2>
    <p>Selamat datang di dokumentasi Lab Maya Titrasi Asam-Basa.</p>
    <h3>Langkah-Langkah Praktikum:</h3>
    <ul>
      <li>1. Pilih Molaritas Basa (NaOH) dan Volume Asam (HCl) pada panel kontrol sebelah kiri.</li>
      <li>2. Klik tombol <strong>"Teteskan Basa (+0.5 mL)"</strong> untuk memulai proses titrasi.</li>
      <li>3. Amati perubahan warna indikator Fenolftalein pada Erlenmeyer (Bening &rarr; Merah Muda).</li>
      <li>4. Perhatikan peringatan jika sudah mendekati titik ekuivalen/titik akhir titrasi.</li>
      <li>5. Hitung Molaritas Asam secara manual menggunakan rumus: <code>Va × Ma = Vb × Mb</code>.</li>
      <li>6. Buka tombol <strong>"Tampilkan / Sembunyikan Perhitungan"</strong> untuk mencocokkan hasil perhitungan manual Anda dengan sistem.</li>
    </ul>
  </div>
</div>

<!-- Audio Elements -->
<audio id="sound-drip" src="suara/drip.mp3"></audio>
<audio id="sound-warning" src="suara/warning.mp3"></audio>
<audio id="sound-finish" src="suara/finish.mp3"></audio>

<script>
  // State Variables
  let targetAcidMolarity = 0.1; // Hidden random target
  let volumeAcid = 10;
  let molarityBase = 0.1;
  let volumeAdded = 0;
  let equivalentVolume = 10; // Vb = (Va * Ma) / Mb

  function startPracticum() {
    document.getElementById('home-screen').classList.remove('active');
    document.getElementById('activity-screen').classList.add('active');
    resetExperiment();
  }

  function resetExperiment() {
    // Generate random Acid Molarity between 0.05 M and 0.30 M for variety
    targetAcidMolarity = (Math.floor(Math.random() * 26) + 5) / 100; 
    
    molarityBase = parseFloat(document.getElementById('molarity-base').value);
    volumeAcid = parseFloat(document.getElementById('volume-acid').value);
    
    // Calculate required titration volume for equivalence: Vb = (Va * Ma) / Mb
    equivalentVolume = (volumeAcid * targetAcidMolarity) / molarityBase;

    volumeAdded = 0;
    document.getElementById('volume-added').innerText = '0.0';
    document.getElementById('color-status').innerText = 'Bening';
    document.getElementById('color-status').style.color = '#fff';
    document.getElementById('flask-fluid').setAttribute('fill', 'rgba(255, 255, 255, 0.2)');
    document.getElementById('warning-banner').style.display = 'none';
    
    // Reset Buret Fluid Height
    document.getElementById('buret-fluid').setAttribute('height', '225');
    document.getElementById('buret-fluid').setAttribute('y', '50');

    // Hide calculations
    document.getElementById('calc-content').style.display = 'none';
    document.getElementById('calc-result').innerText = '? M';
  }

  function drip() {
    volumeAdded += 0.5;
    document.getElementById('volume-added').innerText = volumeAdded.toFixed(1);

    // Play Drip Sound
    playSound('sound-drip');

    // Animate Drop
    let drop = document.getElementById('drip-drop');
    drop.setAttribute('opacity', '1');
    drop.setAttribute('cy', '295');
    let dropAnim = setInterval(() => {
      let cy = parseFloat(drop.getAttribute('cy'));
      if (cy >= 350) {
        drop.setAttribute('opacity', '0');
        clearInterval(dropAnim);
      } else {
        drop.setAttribute('cy', cy + 10);
      }
    }, 20);

    // Update Buret height
    let currentHeight = 225 - (volumeAdded * 5);
    if(currentHeight < 0) currentHeight = 0;
    document.getElementById('buret-fluid').setAttribute('height', currentHeight);
    document.getElementById('buret-fluid').setAttribute('y', 50 + (225 - currentHeight));

    // Check Proximity to Equivalence Point
    let diff = equivalentVolume - volumeAdded;

    if (diff <= 1.5 && diff > 0) {
      // Near Titration End Point - Warning
      document.getElementById('warning-banner').style.display = 'block';
      document.getElementById('flask-fluid').setAttribute('fill', 'rgba(255, 182, 193, 0.5)'); // Light pink hint
      document.getElementById('color-status').innerText = 'Merah Muda Pudar (Hampir Selesai)';
      document.getElementById('color-status').style.color = '#ffb6c1';
      playSound('sound-warning');
    } else if (diff <= 0) {
      // Reached or Passed End Point
      document.getElementById('warning-banner').style.display = 'none';
      document.getElementById('flask-fluid').setAttribute('fill', 'rgba(255, 20, 147, 0.8)'); // Deep Pink
      document.getElementById('color-status').innerText = 'Merah Muda Khas (Titik Akhir Capai)';
      document.getElementById('color-status').style.color = '#ff1493';
      playSound('sound-finish');
      
      // Compute actual result for calc box
      let calculatedMa = (volumeAdded * molarityBase) / volumeAcid;
      document.getElementById('calc-result').innerText = calculatedMa.toFixed(3) + ' M';
    } else {
      document.getElementById('warning-banner').style.display = 'none';
      document.getElementById('flask-fluid').setAttribute('fill', 'rgba(255, 255, 255, 0.2)');
      document.getElementById('color-status').innerText = 'Bening';
      document.getElementById('color-status').style.color = '#fff';
    }
  }

  function toggleCalc() {
    let calcContent = document.getElementById('calc-content');
    if (calcContent.style.display === 'none' || calcContent.style.display === '') {
      calcContent.style.display = 'block';
    } else {
      calcContent.style.display = 'none';
    }
  }

  function playSound(id) {
    let sound = document.getElementById(id);
    if (sound) {
      sound.currentTime = 0;
      sound.play().catch(e => console.log('Audio autoplay prevented'));
    }
  }

  function openDocs() {
    document.getElementById('docs-modal').style.display = 'flex';
  }

  function closeDocs() {
    document.getElementById('docs-modal').style.display = 'none';
  }

  function showPromptAuthor() {
    alert("Penulis Prompt: Leonardus Annies Widya Poetranto, S.Pd.");
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => {
        alert(`Gagal mengaktifkan mode fullscreen: ${err.message}`);
      });
    } else {
      if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    }
  }
</script>
</body>
</html>
